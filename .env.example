# PostgreSQL is the recommended production database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itmanagement?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGIN="http://localhost:5173"
PORT=4000
# Seed an administrator only in a secure environment; never commit an actual password.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-before-first-run"
ADMIN_NAME="Store Admin"
